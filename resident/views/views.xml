<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="resident.list">
      <field name="name">resident list</field>
      <field name="model">resident.resident</field>
      <field name="arch" type="xml">
        <list>
          <field name="tenant_name"/>
          <field name="tenant_middle_name"/>
          <field name="tenant_last_name"/>
          <field name="tenant_move_in_date"/>
          <field name="tenant_move_out_date"/>
          <field name="tenancy_start_date"/>
          <field name="tenancy_end_date"/>
          <field name="Tenancy_duration"/>
          <field name="pets"/>
          <field name="letting_agent"/>
          <field name="parking"/>
          <field name="private_phone"/>
          <field name="private_email"/>
        </list>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="resident_action_window">
      <field name="name">resident window</field>
      <field name="res_model">resident.resident</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="resident" id="resident.menu_root" action="resident_action_window"/>

  </data>
</odoo>
